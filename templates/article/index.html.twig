{% extends 'base.html.twig' %}

{% block title %}Article{% endblock %}

{% block body %}
    <div class="container">
        <div class="row justify-content-center mt-5">
            {% if article is empty %}
                <p>Aucun article trouvé.</p>
            {% endif %}
            <div class="card col-lg-8 mx-auto mb-5">
                <div class="card-body">
                    <h2 class="card-title mb-3">{{ article.title }}</h5>
                    <img src="{{ asset('uploads/images/' ~ article.image) }}" class="card-img-top" alt="{{ article.title }}">
                    <p class="card-text mt-2">{{ article.content }}</p>
                    <p class="card-text mt-2">
                        <small>Créé le {{ article.createdAt|date('d/m/Y à H:i') }}</small>
                        {% if isEdit %}
                            <br><small>Modifié le {{ article.updatedAt|date('d/m/Y à H:i') }}</small>
                        {% endif %}
                    </p>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
