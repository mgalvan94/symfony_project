{% extends 'base.html.twig' %}

{% block title %}Accueil{% endblock %}

{% block body %}
    <div class="container">
        <h2 class="mt-4">Les derniers articles</h2>
        <div class="row my-5">
            {% if articles is empty %}
                <p>Aucun article trouvé.</p>
            {% endif %}
            {% for article in articles %}
                <div class="col-12 col-md-6 col-lg-4 mb-4">
                    <div class="card h-100">
                        <div class="card-body">
                            <h5 class="card-title">{{ article.title }}</h5>
                            <img src="{{ asset('uploads/images/' ~ article.image) }}" class="card-img article-image" alt="{{ article.title }}">
                            <p class="card-text my-2">{{ article.content|slice(0, 100) ~ '...' }}</p>
                            <a href="{{ path('app_article', {'id': article.id}) }}" class="btn btn-warning">Lire la suite</a> 
                            <p class="card-text mt-2">
                                <small>Créé le {{ article.createdAt|date('d/m/Y à H:i') }}</small>
                                {% if isEdit %}
                                    <br><small>Modifié le {{ article.updatedAt|date('d/m/Y à H:i') }}</small>
                                {% endif %}
                            </p>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
{% endblock %}
