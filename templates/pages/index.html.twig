{% extends 'base.html.twig' %}

{% block title %}Accueil{% endblock %}

{% block body %}
    <div class="container">
        <h1>Accueil</h1>
        <h2 class="mt-4">Les derniers articles</h2>
        <div class="row my-5" data-masonry='{"percentPosition": true }'>
            {% if articles is empty %}
                <p>Aucun article trouvé.</p>
            {% endif %}
            {% for article in articles %}
                <div class="col-12 col-md-6 col-lg-4 mb-4">
                    <div class="card h-100">
                        <div class="card-body">
                            <h5 class="card-title">{{ article.title }}</h5>
                            <img src="{{ asset('uploads/images/' ~ article.image) }}" class="card-img-top" alt="{{ article.title }}">
                            <p class="card-text">{{ article.content|slice(0, 100) ~ '...' }}</p>
                            <p class="card-text"> Créé le {{ article.createdAt|date('d/m/Y à H:i') }}</p> {% if isEdit%}
                                Modifié le {{ article.updatedAt|date('d/m/Y à H:i') }}
                            {% endif %}
                            {# <a href="{{ path('article_show', {'id': article.id}) }}" class="btn btn-primary">Lire la suite</a> #}
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
{% endblock %}
