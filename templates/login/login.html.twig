{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
    <div class="container min-vh-100 d-flex flex-column justify-content-center">
        <h1 class="text-center mb-5">Connexion</h1>
        <div class="row justify-content-center">
            <div class="col-12 col-md-6 col-lg-5">
                <form method="post">
                    <div class="card p-4 shadow-sm form">
                        {% if error %}
                            <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                        {% endif %}

                        {% if app.user %}
                            <div class="mb-3">
                                Vous êtes connecté ! <a href="{{ logout_path() }}">Déconnexion</a>
                            </div>
                        {% endif %}
                        <label class="mb-2" for="username">Email</label>
                        <input type="email" value="{{ last_username }}" name="_username" id="username" class="form-control mb-3" autocomplete="email" required autofocus>
                        <label class="my-2" for="password">Password</label>
                        <div class="input-group mb-5">
                            <input type="password" name="_password" id="inputPassword" class="form-control" autocomplete="current-password" required>
                            <button
                                type="button"
                                class="btn btn-warning"
                                onclick="const i = this.previousElementSibling; i.type = i.type === 'password' ? 'text' : 'password';"
                            >
                                👀
                            </button>
                        </div>
                        <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

                        <button class="btn btn-warning" type="submit">
                            Connexion
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
{% endblock %}
